# Veritabanı — uygulama (pooler olabilir)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=verify-full"
# Migration/seed — pooler OLMAYAN doğrudan bağlantı
DATABASE_URL_DIRECT="postgresql://user:pass@host/db?sslmode=verify-full"

# Oturum ve şifreleme anahtarı (en az 32 bayt): node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Site
NEXT_PUBLIC_SITE_URL="https://www.lagenyazilim.com.tr"
# Yalnızca yerel geliştirmede http kabul etmek için 1
SITE_URL_ALLOW_INSECURE=0

# Dosya depolama kökü (public/ ve private/ alt klasörleri oluşturulur)
STORAGE_DIR="./storage"

# SMTP (boşsa bildirimler "skipped" olarak kaydedilir; admin panelinden de girilebilir)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Lagen Yazılım <info@lagenyazilim.com.tr>"
NOTIFY_TO="info@lagenyazilim.com.tr"
